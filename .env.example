# Optional. Copy to .env to change a value; every value below is already the default.
# Never commit .env.

# Django secret key. Leave empty locally: dev and test then use an insecure built-in key.
DJANGO_SECRET_KEY=

# Database name. Postgres reads this and the next two only when the db volume is first created.
POSTGRES_DB=trainer
# Database user.
POSTGRES_USER=trainer
# Database password.
POSTGRES_PASSWORD=trainer

# Database host for tools run on the host (uv run pytest, manage.py). Compose overrides it to db.
POSTGRES_HOST=localhost
# Database port for tools run on the host. Compose overrides it to 5432 inside its containers.
POSTGRES_PORT=5433
